# Copy this file to .env and fill in your keys. .env is git-ignored - never commit real keys.
GROQ_API_KEY=your_groq_key_here          # https://console.groq.com/keys
TAVILY_API_KEY=your_tavily_key_here      # https://app.tavily.com

# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=http://localhost:11434/v1   # Ollama (local LLM) instead of Groq
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
